#!/usr/bin/env python3
import os, socket, sys
SOCK = "/tmp/probe-stage.sock"
def ask(msg):
    s = socket.socket(socket.AF_UNIX); s.connect(SOCK); s.sendall(msg.encode()); s.shutdown(socket.SHUT_WR)
    print(s.makefile().read())
cmd = sys.argv[1]
if cmd == "start":
    if os.fork():
        print("started"); sys.exit(0)
    os.setsid()
    if os.fork(): os._exit(0)
    fd = os.open(os.devnull, os.O_RDWR)
    for i in (0, 1, 2): os.dup2(fd, i)
    if os.path.exists(SOCK): os.unlink(SOCK)
    srv = socket.socket(socket.AF_UNIX); srv.bind(SOCK); srv.listen()
    env = {}
    while True:
        c, _ = srv.accept()
        req = c.makefile().read()
        if req == "__stop__":
            c.sendall(b"stopped"); c.close(); os.unlink(SOCK); os._exit(0)
        try: rep = repr(eval(req, env))
        except Exception as e: rep = "error: %r" % e
        c.sendall(rep.encode()); c.close()
elif cmd == "step": ask(" ".join(sys.argv[2:]))
elif cmd == "stop": ask("__stop__")
