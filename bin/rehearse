#!/usr/bin/env python3
"""rehearse: the plugin's commands. They read the job file, never write it; the last line they print is
REHEARSE-RESULT <json>, which the plugin's hook records.

  rehearse plan --goal <item> request|answer|assumed '<text>' (x4) --stage-def <name> fix|build '<plan line>' <inputs> <outputs>
                [--stage-def ...] [--assume '<text>'] [--blocker '<text>'] [--from-request] [--stage <n>]
  rehearse ending [--job] --cmd '<cmd>' [--tests '<cmd>'] --expect '<requirement>' <check> <value> --cite <citation>
                  ... [--unchecked '<taste item>']
  rehearse run [--as-director] [--stage <n>]
  rehearse fetch <url> [curl args]
  rehearse job          (also: rehearse status)
  rehearse stuck --stop-here | --try-again | --change --confirmed   (the user's answer to the stuck question)

goal items: purpose, deliverable, done, out_of_scope; a source of request or answer needs the text word for word
in the request or in the user's answers. inputs/outputs: comma-separated paths, or - for none.
checks: equals, contains, regex, exit_code, fixture_equals. citations: fixture:<name>, step:S<n>, request.
"""
import argparse
import json
import os
import re
import secrets
import subprocess
import sys
import urllib.parse

PLUGIN = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(PLUGIN, "hooks"))
import ending as E  # noqa: E402
import log as L  # noqa: E402
import state as S  # noqa: E402

TIMEOUT = float(os.environ.get("REHEARSE_RUN_TIMEOUT", "270"))  # two runs (program, then tests) fit the Bash cap
FOLDER = None  # the run folder once the job is found: every result is recorded there before it is printed


def result(run, kind, **kw):
    # field order is an interface: run, kind, ok (when given), then the rest; graders read this line from the trace
    head = dict(run=run, kind=kind)
    if "ok" in kw:
        head["ok"] = kw.pop("ok")
    res = dict(head, **kw, id=secrets.token_hex(4))
    if FOLDER:  # the hook reads this record: a pipe that cuts or truncates the printed line loses nothing
        try:
            L.record_result(FOLDER, res)
        except OSError as x:
            print("could not record the result in the run folder (%s): run this again on its own" % x)
    print("REHEARSE-RESULT " + json.dumps(res, ensure_ascii=False))


def clip(text, n=4000):
    return text if len(text) <= n else text[:n] + "\n... (%d more characters)" % (len(text) - n)


def sh(cmd, cwd, env=None):
    """(rc, stdout, stderr); rc is None on a timeout."""
    try:
        p = subprocess.run(cmd, shell=True, executable="/bin/bash", cwd=cwd, capture_output=True, text=True,
                           errors="replace", timeout=TIMEOUT, env=env)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired as x:
        dec = lambda b: (b or b"").decode("utf-8", "replace") if isinstance(b, bytes) else (b or "")  # noqa: E731
        return None, dec(x.stdout), dec(x.stderr)


def run_ending(s):
    """Run the ending command from the root with the tracer attached; print and return the outcome."""
    e = s["ending"]
    trace = os.path.join(s["run_folder"], "trace.jsonl")
    since = os.path.getsize(trace) if os.path.exists(trace) else 0
    pp = os.environ.get("PYTHONPATH")
    env = dict(os.environ, REHEARSE_TRACE=trace, REHEARSE_ROOT=s["root"],
               PYTHONPATH=os.path.join(PLUGIN, "tracer") + (os.pathsep + pp if pp else ""))
    rc, out, err = sh(e["cmd"], s["root"], env)
    results = E.evaluate(e["expectations"], rc, out, err, os.path.join(s["run_folder"], "fixtures"))
    print("$ " + e["cmd"])
    print("rc: " + ("timed out after %ds" % TIMEOUT if rc is None else str(rc)))
    print("stdout:\n" + clip(out).rstrip())
    print("stderr:\n" + clip(err).rstrip())
    trace_lines = L.trace_lines(trace, since)
    if trace_lines:
        print("trace:\n" + "\n".join(trace_lines))
    for r in results:
        print("%s  %s: %s %r" % ("PASS" if r["passed"] else "FAIL", r["requirement"], r["check"], r["value"]))
    return {"rc": rc, "stdout": clip(out), "stderr": clip(err), "results": results,
            "all_pass": all(r["passed"] for r in results)}


def baseline(s, tests):
    """Run the relevant tests once while the code is the activation state (plan 2.5)."""
    cmd = E.relevant_tests(s["ending"]["cmd"], tests, s["root"])
    if not cmd:
        return {"cmd": None, "note": "no tests found"}
    rc, out, err = sh(cmd, s["root"])
    both = out + "\n" + err
    if rc is None:
        return {"cmd": cmd, "note": "timed out; narrow with --tests"}
    note = E.could_not_start(rc, both)
    tail = "\n".join([ln for ln in both.splitlines() if ln.strip()][-20:])
    return {"cmd": cmd, "note": note} if note else {"cmd": cmd, "rc": rc, "tail": tail}


def sources(s):
    # a `rehearse ending` or `rehearse run` step echoes the expected values, so it can never be a source for them;
    # judged by the result kind the logger recorded, so the command's spelling ($R ending, a path) does not matter
    steps = {r["step"]: r.get("out", "") for r in L.records(s["run_folder"])
             if "step" in r and r.get("result") not in ("ending", "run")}
    fixtures = {}
    for name in s.get("fixtures", []):
        try:
            with open(os.path.join(s["run_folder"], "fixtures", name), encoding="utf-8", errors="replace") as f:
                fixtures[name] = f.read()
        except OSError:
            pass
    return {"request": "\n".join([s.get("request") or ""] + s.get("prompts", [])), "steps": steps, "fixtures": fixtures}


def cmd_plan(s, argv):
    ap = argparse.ArgumentParser(prog="rehearse plan")
    ap.add_argument("--goal", nargs=3, action="append", default=[], metavar=("ITEM", "SOURCE", "TEXT"))
    ap.add_argument("--stage-def", nargs=5, action="append", default=[],
                    metavar=("NAME", "KIND", "LINE", "INPUTS", "OUTPUTS"))
    ap.add_argument("--assume", action="append", default=[])
    ap.add_argument("--blocker", action="append", default=[])
    ap.add_argument("--from-request", action="store_true")
    ap.add_argument("--stage", type=int)
    try:
        a = ap.parse_args(argv)
    except SystemExit:
        return result(s["run_id"], "plan", ok=False, error="bad arguments; see the usage above")
    texts = {"request": s.get("request") or "", "answer": "\n".join(s.get("prompts", []))}
    goal, problems = {}, []
    for item, src, text in a.goal:
        if item not in S.GOAL_ITEMS or src not in ("request", "answer", "assumed"):
            problems.append("--goal %s %s: the item is one of %s, the source request, answer or assumed"
                            % (item, src, ", ".join(S.GOAL_ITEMS)))
        elif src != "assumed" and text not in texts[src]:
            problems.append("goal %s: %r does not appear word for word in %s" % (
                item, text, "the request" if src == "request" else "the user's answers"))
        else:
            goal[item] = {"text": text, "source": src}
    if a.stage is None:
        problems += ["goal item %s has no answer and no assumption" % i for i in S.GOAL_ITEMS if i not in goal]
    split = lambda x: [] if x.strip() in ("", "-") else [v.strip() for v in x.split(",") if v.strip()]  # noqa: E731
    stages = [{"name": n, "kind": k, "line": ln, "inputs": split(i), "outputs": split(o)}
              for n, k, ln, i, o in a.stage_def]
    problems += ["stage %r: the kind is fix or build" % st["name"] for st in stages if st["kind"] not in ("fix", "build")]
    if len(stages) != 1 and a.stage is not None:
        problems.append("--stage <n> takes exactly one --stage-def")
    elif not stages:
        problems.append("a plan needs at least one --stage-def")
    why = S.plan_refused(s, a.stage)
    if why:
        problems.append(why)
    if problems:
        print("plan refused:\n" + "\n".join("  " + p for p in problems))
        return result(s["run_id"], "plan", ok=False, error="; ".join(problems))
    assumptions = ["%s: %s" % (i, g["text"]) for i, g in goal.items() if g["source"] == "assumed"] + a.assume
    for i, st in enumerate(stages, a.stage or 1):
        print("stage %d %s (%s): %s; in: %s; out: %s" % (i, st["name"], st["kind"], st["line"],
                                                       ", ".join(st["inputs"]) or "-", ", ".join(st["outputs"]) or "-"))
    return result(s["run_id"], "plan", ok=True, goal=goal, stages=stages, assumptions=assumptions,
                  blockers=a.blocker, from_request=a.from_request, change=a.stage)


def cmd_ending(s, argv):
    ap = argparse.ArgumentParser(prog="rehearse ending")
    ap.add_argument("--job", action="store_true")
    ap.add_argument("--cmd", required=True)
    ap.add_argument("--tests")
    ap.add_argument("--expect", nargs=3, action="append", default=[], metavar=("REQUIREMENT", "CHECK", "VALUE"))
    ap.add_argument("--cite", action="append", default=[])
    ap.add_argument("--unchecked", action="append", default=[])
    # stage and stages_passed come right after kind: the multi-stage eval greps this line (brief section 13)
    res = lambda **kw: result(s["run_id"], "ending", stage=s.get("stage"), stages_passed=S.passed(s), **kw)  # noqa
    try:
        a = ap.parse_args(argv)
    except SystemExit:
        return res(ok=False, error="bad arguments; see the usage above")
    why = S.ending_refused(s, a.job)
    if not why and not (a.job and not S.final(s)) and s.get("reopen") and not s["reopen"]["looks"]:
        why = S.NO_LOOK  # refused before the command runs: an ending with side effects must not run first
    if why:
        print(why)
        return res(ok=False, error=why)
    if len(a.cite) != len(a.expect):
        print("every --expect needs its own --cite")
        return res(ok=False, error="every --expect needs its own --cite")
    exps = [{"requirement": r, "check": c, "value": v, "cite": cite} for (r, c, v), cite in zip(a.expect, a.cite)]
    problems = E.validate(exps, sources(s))
    if problems:
        print("ending refused:\n" + "\n".join("  " + p for p in problems))
        return res(ok=False, error="; ".join(problems))
    s = dict(s, ending={"cmd": a.cmd, "tests": a.tests, "expectations": exps, "unchecked": a.unchecked})
    before = run_ending(s)
    base = None
    if not before["all_pass"]:
        base = baseline(s, a.tests)
        print("baseline: %s -> %s" % (base["cmd"], base.get("note") or "rc %s" % base.get("rc")))
    return res(ok=True, job=a.job, ending=s["ending"], before=before, baseline=base, all_pass=before["all_pass"])


def cmd_run(s, argv):
    n = None
    if "--stage" in argv:
        try:
            n = int(argv[argv.index("--stage") + 1])
        except (IndexError, ValueError):
            print("usage: rehearse run --stage <n> --as-director")
            return result(s["run_id"], "run", ok=False, error="bad arguments")
        stages = s.get("stages") or []
        current = not S.final(s) and n == s.get("stage")  # the live ending: the same as a plain director run
        why = ("--stage needs --as-director" if "--as-director" not in argv else
               None if current else
               "--stage is accepted only in the final stage, or for the current stage" if not S.final(s) else
               "stage %d has no archived ending" % n if not (1 <= n <= len(stages) and stages[n - 1].get("ending"))
               else None)
        if why:
            print(why)
            return result(s["run_id"], "run", ok=False, error=why)
        if current:
            n = None
        else:
            s = dict(s, ending=stages[n - 1]["ending"])
    if not s.get("ending"):
        print("no ending registered yet; run rehearse ending first")
        return result(s["run_id"], "run", ok=False, error="no ending")
    r = run_ending(s)
    print("all expectations pass" if r["all_pass"] else "not every expectation passes")
    if "--as-director" in argv:
        r["as_director"] = True
    if n:
        r["stage_rerun"] = n
    return result(s["run_id"], "run", ok=True, **r)


def cmd_fetch(s, argv):
    if not argv:
        print("usage: rehearse fetch <url> [curl args]")
        return result(s["run_id"], "fetch", ok=False, error="no url")
    url, extra = argv[0], argv[1:]
    u = urllib.parse.urlsplit(url)
    folder = os.path.join(s["run_folder"], "fixtures")
    stem = re.sub(r"[^\w.-]+", "_", (u.netloc + u.path).strip("/"))[:60] or "fetch"
    name, n = stem, 1
    while os.path.exists(os.path.join(folder, name)):
        n += 1
        name = "%s-%d" % (stem, n)
    path = os.path.join(folder, name)
    p = subprocess.run(["curl", "-sS", "-L", "-o", path] + extra + [url], capture_output=True, text=True,
                       errors="replace", timeout=TIMEOUT)
    ok = p.returncode == 0 and os.path.exists(path)
    body = open(path, encoding="utf-8", errors="replace").read() if ok else ""
    print("fixture: %s (%d bytes)" % (name, len(body)) if ok else "fetch failed: " + p.stderr.strip())
    print("\n".join(body.splitlines()[:40]))
    return result(s["run_id"], "fetch", ok=ok, url=url, host=u.hostname, fixture=name if ok else None,
                  rc=p.returncode, bytes=len(body))


def cmd_job(s, argv):
    print(S.job_text(s))
    return result(s["run_id"], "job", ok=True, phase=s["phase"], stage=s.get("stage"), stages_passed=S.passed(s))


def cmd_stuck(s, argv):
    """The manager records the user's answer to the stuck question; the plugin never reads it from their words."""
    ap = argparse.ArgumentParser(prog="rehearse stuck")
    g = ap.add_mutually_exclusive_group(required=True)
    for flag in ("--stop-here", "--try-again", "--change"):
        g.add_argument(flag, action="store_true")
    ap.add_argument("--confirmed", action="store_true")
    try:
        a = ap.parse_args(argv)
    except SystemExit:
        return result(s["run_id"], "stuck", ok=False, error="one of --stop-here, --try-again, --change --confirmed")
    answer = "stop here" if a.stop_here else "try again" if a.try_again else "change"
    why = None
    if answer != "stop here" and s["phase"] not in ("stuck", "look"):
        why = "rehearse stuck is accepted in stuck, or in look after a blocked look worker; the job is in %s" % s["phase"]
    elif answer == "change" and not a.confirmed:
        why = ("change redoes %s from the look: a look worker, the ending registered and confirmed again, then the "
               "build and the director; strikes reset. Put that to the user as one yes-or-no question, and run this "
               "again with --confirmed only after an explicit yes" % S.label(s))
    if why:
        print(why)
        return result(s["run_id"], "stuck", ok=False, error=why)
    print("recorded: " + answer)
    return result(s["run_id"], "stuck", ok=True, answer=answer)


def cmd_stage(s, argv):
    sys.path.insert(0, os.path.join(PLUGIN, "stage"))
    import client
    client.FOLDER = FOLDER
    client.main(s, argv)


def main():
    global FOLDER
    cmds = {"plan": cmd_plan, "ending": cmd_ending, "run": cmd_run, "fetch": cmd_fetch, "job": cmd_job,
            "status": cmd_job, "stuck": cmd_stuck, "stage": cmd_stage}
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        print(__doc__)
        return result(None, "usage", ok=False)
    kind = sys.argv[1]
    s = S.find_for_cwd(os.getcwd())
    if not s:
        print("no active rehearse job in this directory or above it")
        return result(None, kind, ok=False, error="no run")
    FOLDER = s["run_folder"]
    cmds[kind](s, sys.argv[2:])


if __name__ == "__main__":
    main()
