$ printf 'Fix marks being lost when a test class inherits from multiple marked base classes; marks are now collected across the MRO.\n' > changelog/7792.bugfix.rst; cat >> testing/test_mark.py <<'EOF'


def test_mark_mro_multiple_bases(pytester: Pytester) -> None:
    """Marks from all base classes are collected (#7792)."""
    pytester.makepyfile(
        """
        import pytest

        @pytest.mark.foo
        class Foo: pass

        @pytest.mark.bar
        class Bar: pass

        class TestDings(Foo, Bar):
            def test_dings(self, request):
                names = {m.name for m in request.node.iter_markers()}
                assert {"foo", "bar"} <= names
        """
    )
    pytester.runpytest().assert_outcomes(passed=1)
EOF
