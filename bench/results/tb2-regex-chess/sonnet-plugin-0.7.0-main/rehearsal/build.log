$ cd /app; cat > /tmp/rt.py <<'EOF'
import random, chess, json, re
pats=json.load(open("/app/re.json"))
def sol(fen):
    for p,r in pats: fen=re.sub(p,r,fen)
    return set(x.rpartition(" ")[0] if False else " ".join(x.split(" ")[:-2]) for x in fen.split("\n"))
random.seed(1); n=0; bad=0
for g in range(60):
    b=chess.Board()
    for ply in range(120):
        if b.is_game_over(): break
        if b.turn:
            exp=set()
            for m in b.legal_moves:
                c=b.copy(); c.push(m); exp.add(" ".join(c.fen().split(" ")[:-2]))
            got=sol(b.fen()); n+=1
            ok = len(got)==len(exp) and all(x in exp or x.rpartition(" ")[0]+" -" in exp for x in got)
            if not ok:
                bad+=1; print("BAD",b.fen(),got^exp)
        ms=list(b.legal_moves)
        # favour castling/ep/promo
        pref=[m for m in ms if b.is_castling(m) or b.is_en_passant(m) or m.promotion]
        b.push(random.choice(pref) if pref and random.random()<.8 else random.choice(ms))
print(n,bad)
EOF
