print([m["Subject"] for m in mailbox.mbox("/var/mail/ann")])
e.send_email(body="",subject="",from_addr="ann@local.edu",to_addr=e.LEAVE_LIST)
e.retry(lambda: e.confirm_last_reply("ann","leave"))
sleep(3)
print("member after leave:", e.get_mlist().members.get_member("ann@local.edu"))
EOF
