$ cat > /tmp/work/sim.py <<'EOF'
import re
S={};n=None
for l in open('/app/sequences.fasta'):
    l=l.strip()
    if l.startswith('>'): n=l[1:];S[n]=''
    elif l: S[n]+=l.upper()
P={};n=None
for l in open('/app/primers.fasta'):
    l=l.strip()
    if l.startswith('>'): n=l[1:]
    else: P[n]=l.upper()
rc=lambda s:s[::-1].translate(str.maketrans('ACGT','TGCA'))
def pcr(name,circ=False):
    t=S[name]; f=P[name+'_fwd']; r=P[name+'_rev']
    fa=f[f.index('GGTCTC')+7:]  # after N
    # find 3' annealing: longest suffix of primer that matches
    def anneal(p,t):
        for L in range(len(p),10,-1):
            if p[-L:] in t: return L
    Lf=anneal(f,t); Lr=anneal(r,rc(t) if False else t+t if False else t) 
    return None
def prod(name):
    t=S[name]; tt=t+t if name=='input' else t
    f=P[name+'_fwd']; r=P[name+'_rev']
    def ann(p,tt):
        for L in range(len(p),10,-1):
            if p[-L:] in tt or False: return L
    Lf=0
    for L in range(len(f),10,-1):
        if f[-L:] in tt: Lf=L;break
    rr=rc(r); Lr=0
    for L in range(len(rr),10,-1):
        if rr[:L] in tt: Lr=L;break
    # 5' tails
    ftail=f[:len(f)-Lf]; rtail=rc(r[:len(r)-Lr])
    s=tt.index(f[-Lf:]); 
    e=tt.index(rr[:Lr],s)+Lr
    return ftail+tt[s:e]+rtail
frags=[]
for k in ['input','egfp','flag','snap']:
    p=prod(k)
    assert len(re.findall('GGTCTC|GAGACC',p))==2,(k,len(re.findall('GGTCTC|GAGACC',p)))
    a=p.index('GGTCTC')+7; b=p.rindex('GAGACC')-5  # top strand: after N1 ; rev site: GAGACC then N then 4... 
    # top strand cut after N1 of fwd site; right end top cut is 5 before GAGACC reversed: bottom cut after N1 -> top overhang ends at pos of GAGACC-1-1
    b=p.rindex('GAGACC')-1
    frags.append((k,p[a:b]))   # includes 4nt overhangs both ends
    print(k,len(p),p[a:a+4],p[b-4:b])
# ligate in order input->egfp->flag->snap->input
asm=''
for i,(k,s) in enumerate(frags):
    asm+= s[:-4]
print(len(asm), asm==S['output'], any(asm==S['output'][i:]+S['output'][:i] for i in range(len(asm))) if len(asm)==len(S['output']) else None)
EOF
